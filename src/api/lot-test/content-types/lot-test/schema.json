{
  "kind": "collectionType",
  "collectionName": "lot_tests",
  "info": {
    "singularName": "lot-test",
    "pluralName": "lot-tests",
    "displayName": "Lot Test"
  },
  "options": {
    "draftAndPublish": true,
    "populateCreatorFields": true
  },
  "attributes": {
    "lotNumber": {
      "type": "string",
      "required": true
    },
    "uniqueCode": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "isConsumed": {
      "type": "boolean",
      "default": false
    },
    "consumedAt": {
      "type": "datetime",
      "required": false
    },
    "productName": {
      "type": "string",
      "required": true
    },
    "reward": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "consumedByAccount": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::account.account"
    }
  }
}
