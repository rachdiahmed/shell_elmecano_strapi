{
  "kind": "collectionType",
  "collectionName": "accounts",
  "info": {
    "singularName": "account",
    "pluralName": "accounts",
    "displayName": "Account"
  },
  "options": {
    "draftAndPublish": true,
    "populateCreatorFields": true
  },
  "pluginOptions": {},
  "attributes": {
    "userId": {
      "type": "integer",
      "unique": true
    },
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "cin": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "governorate": {
      "type": "string",
      "required": true
    },
    "taxId": {
      "type": "string",
      "required": false
    },
    "ownReferralCode": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "wantNewsletterSubscription": {
      "type": "boolean",
      "default": false
    },
    "hasCompletedProfile": {
      "type": "boolean",
      "default": false
    },
    "gains": {
      "type": "decimal",
      "default": 0
    },
    "rank": {
      "type": "integer",
      "default": 0
    },
    "vidangesCount": {
      "type": "integer",
      "default": 0
    },
    "garageName": {
      "type": "string",
      "required": false
    },
    "address": {
      "type": "text",
      "required": false
    },
    "birthDate": {
      "type": "date",
      "required": false
    },
    "postalCode": {
      "type": "string",
      "required": false
    },
    "profileImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "notificationDevices": {
      "type": "json"
    },
    "inAppNotifications": {
      "type": "json"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "account"
    },
    "referredBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::account.account",
      "comment": "Le compte qui a parrainé cet utilisateur",
      "inversedBy": "referredAccounts"
    },
    "referredAccounts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::account.account",
      "comment": "Les comptes parrainés par cet utilisateur",
      "mappedBy": "referredBy"
    },
    "gainOrders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gain-order.gain-order",
      "mappedBy": "account"
    }
  }
}
